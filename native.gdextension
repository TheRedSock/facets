[configuration]
entry_symbol = "gem_trace_init"
compatibility_minimum = "4.5"

[libraries]
windows.debug.x86_64 = "res://native/lib/win64/gem_trace.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/lib/win64/gem_trace.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://native/lib/linux64/libgem_trace.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/lib/linux64/libgem_trace.linux.template_release.x86_64.so"
macos.debug = "res://native/lib/macos/libgem_trace.macos.template_debug.framework"
macos.release = "res://native/lib/macos/libgem_trace.macos.template_release.framework"
