[resource]
script = ExtResource("1_e3irg")
chromophore_id = &"ruby_cr"
display_name = "Chromium (ruby, corundum)"
source_note = "Cr3+ in corundum. o-ray (E⊥c): Y band ~410 nm, U band ~556 nm (GIA G&G Spring 2020 Dubinsky et al.), B-lines ~468-475 nm, ~480 nm transmission saddle, R-line 694 nm. e-ray (E∥c): ~420/~552 with weaker U band. Curves authored for the kernel's GIA polarisation mix (face-up ≈ pure o-ray when optic axis ≈ +Z). Concentration 0.40 so a 5.4 mm stone keeps pavilion-returned red over a ~4×size TIR path after the polarisation fix (was 0.55 against an inverted mix). Daylight fluorescence override 0.05 @ 693 nm."
