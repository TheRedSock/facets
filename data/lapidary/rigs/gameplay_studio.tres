[resource]
script = ExtResource("1_rig")
rig_id = &"gameplay_studio"
display_name = "Gameplay Studio"
lights = [SubResource("key"), SubResource("spark"), SubResource("rim"), SubResource("beauty"), SubResource("fill"), SubResource("bounce")]
bg_zenith = 0.14
bg_horizon = 0.09
bg_below = 0.03
bg_kelvin = 5600.0
white_kelvin = 5600.0
dual_illuminant_kelvin = 0.0
