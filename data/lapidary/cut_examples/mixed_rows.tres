[sub_resource type="Resource" id="Resource_domdi"]
script = ExtResource("15_3luih")
species_id = &"quartz"
display_name = "Quartz (SiO2)"
source_note = "Alpha-quartz principal dispersion: Ghosh (1999), ordinary and extraordinary curves; see per-axis evidence. Optic axis normal to the table. Mohs hardness is metadata; color and specimen scattering are separate authored inputs."
