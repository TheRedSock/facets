citation = "2-term Sellmeier FIT (this file's generator): targets n_D=1.577 (natural emerald n_omega 1.575-1.600, geo.libretexts Gemology: Emerald) and B-G dispersion 0.014; UV pole 0.025 um^2 + constant term. Birefringence 0.006 uniaxial(-) (lit. 0.004-0.010). Mohs 7.75 (lit. 7.5-8)."
method = "Authored constant offset from the ordinary dispersion model"
assumptions = "Extraordinary dispersion is unmeasured here. A constant index difference is an approximation; biaxial species additionally use an effective uniaxial model."

