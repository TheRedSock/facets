[sub_resource type="Resource" id="Resource_mn171"]
script = ExtResource("1_d55if")
kind = 1
citation = "M. J. Dodge, Refractive index, Handbook of Laser Science and Technology IV, Optical Materials Part 2 (1986), p.30; refractiveindex.info Al2O3/Malitson-e"
method = "Published principal dispersion transcribed from the CC0 refractiveindex.info database; formula-1 poles squared into um^2, formula-2 constant stored as C=0 term"
source_record = {
"coefficients": [0, 1.5039759, 0.0740288, 0.55069141, 0.1216529, 6.5927379, 20.072248],
"formula": 1,
"url": "https://raw.githubusercontent.com/polyanskiy/refractiveindex.info-database/master/database/data/main/Al2O3/nk/Malitson-e.yml"
}
temperature_kelvin = 293.0
assumptions = "Synthetic sapphire at 20 C. The 1972 Malitson/Dodge reference is a conference abstract; the database attributes the dispersion formula to Dodge 1986. Dopant/composition and temperature changes are not modeled."

