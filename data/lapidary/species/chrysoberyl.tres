citation = "2-term Sellmeier FIT (this file's generator): targets n_D=1.746 (GIA alexandrite page: RI 1.746-1.755) and B-G dispersion 0.015 (cigem.ca alexandrite report); UV pole 0.025 um^2 + constant term. Biaxial(+), approximated uniaxial(+) with delta-n 0.009 (lit. 0.008-0.010). Mohs 8.5."
method = "Authored constant offset from the ordinary dispersion model"
assumptions = "Extraordinary dispersion is unmeasured here. A constant index difference is an approximation; biaxial species additionally use an effective uniaxial model."

