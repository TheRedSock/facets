[sub_resource type="Resource" id="group_crown"]
script = ExtResource("3")
group_id = &"crown"
directions = SubResource("set_main")
inclination = "p.crown * p.crown_scale"
side = 1
height = "p.girdle"
scale = "1"
inset = "0"
zone = 1
meet_groups = PackedStringArray()

[sub_resource type="Resource" id="group_upper"]
