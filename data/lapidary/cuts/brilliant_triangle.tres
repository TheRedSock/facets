[sub_resource type="Resource" id="group_table"]
script = ExtResource("3")
group_id = &"table"
directions = SubResource("set_axis")
inclination = "0"
side = 1
height = "p.girdle + (1-p.table) * s.main.mean_support * tan(deg_to_rad(p.crown * p.crown_scale))"
scale = "0"
inset = "0"
zone = 0
meet_groups = PackedStringArray()

[sub_resource type="Resource" id="group_pavilion"]
script = ExtResource("3")
