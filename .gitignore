# Godot 4+ specific ignores
.godot/
.nomedia

# Export configs
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Design, plans and historical documentation are versioned.
# Local reports, tool installations and regenerable render output stay local.
generated/
artifacts/**
!artifacts/.gdignore
__pycache__/
*.pyc
# GLSL kernels are runtime-compiled source, not editor-imported resources.
*.glsl.import

# Optional Python tooling environments.
.venv/
.venv-reference/
